  "cards": [
    {
      "dot": "cyan",
      "title": "矢印の読み方",
      "items": [
        "実線は実行時の呼出、破線は起動時の組み立て。",
        "import は handler → usecase → domain。repository → usecase / domain。"
      ]
    },
    {
      "dot": "emerald",
      "title": "依存性逆転とトランザクション",
      "items": [
        "usecase/port.go が UserRepository と TxManager を定義。",
        "UserUsecase.Create は重複確認と INSERT を TxManager.Do で囲む。"
      ]
    },
    {
      "dot": "violet",
      "title": "HTTP と永続化の境界",
      "items": [
        "POST /users、GET /users/:id。GET /healthz は router 内で完結。",
        "handler が DTO・HTTPエラー変換、repository が SQL・復元を担当。"
      ]
    }
  ]
