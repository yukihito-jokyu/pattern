  "cards": [
    {
      "dot": "cyan",
      "title": "呼び出しと依存方向",
      "items": [
        "実線＝実行時の呼び出し。破線＝起動時の初期化・配線。",
        "import は handler → usecase → domain。repository → usecase / domain。",
        "usecase が port を定義し、main がその実装と同じ *sql.DB を注入する。"
      ]
    },
    {
      "dot": "emerald",
      "title": "作成・取得と整合性",
      "items": [
        "作成：Email / User を検証 → Tx 内で EXISTS・INSERT → Commit → 201。",
        "取得：ParseID → SELECT → Reconstruct → UserOutput → DTO → 200。",
        "競合作成は email UNIQUE が防ぎ、SQLSTATE 23505 をドメインエラーへ変換。"
      ]
    },
    {
      "dot": "violet",
      "title": "HTTP と実行基盤",
      "items": [
        "JSON は最大 1 MiB、未知フィールドを拒否。400 / 404 / 409、未知エラーは 500。",
        "/healthz は router 内で 200 を返す。DB への Ping は起動時に実施。",
        "接続プール 25 / 25・寿命 5 分。HTTP 5 / 10 / 10 / 60 秒、停止猶予 10 秒。"
      ]
    }
  ]
}
