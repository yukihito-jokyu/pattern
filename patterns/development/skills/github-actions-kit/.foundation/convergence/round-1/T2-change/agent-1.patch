+def failed_steps(job: Job) -> str:
+    """失敗したジョブなら、失敗したステップの名前を「、」でつなぐ。それ以外のジョブは空にする。"""
+    if job.conclusion != "failure":
+        return ""
+    return "、".join(_cell(step.name) for step in job.steps if step.conclusion == "failure")
 
 
