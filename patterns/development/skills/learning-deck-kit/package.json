{
  "name": "learning-deck-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "check": "node tools/check.mjs",
    "fix": "prettier --write '**/*.{mjs,json,html,css}' && eslint --fix .",
    "format": "prettier --check '**/*.{mjs,json,html,css}'",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.tests.json",
    "structure": "node tools/structure.mjs",
    "test": "node --test tests/model.test.mjs tests/cli.test.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "verify:decks": "node tools/verify-decks.mjs",
    "verify:examples": "node tools/verify-examples.mjs",
    "build": "node tools/learning.mjs build courses/go build/site",
    "serve": "node tools/serve.mjs build/site"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
