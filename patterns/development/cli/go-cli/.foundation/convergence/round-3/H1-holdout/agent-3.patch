+	var opts listOptions
+	return &cli.Command{
+		Name:    "list",
+		Summary: "List notes",
+		Run: func(ctx context.Context) (cli.Output, error) {
+			return runList(ctx, svc, opts)
+		},
+	}
+}
+
+// runList runs note list.
+func runList(ctx context.Context, svc *note.Service, _ listOptions) (listOutput, error) {
+	notes, err := svc.List(ctx)
+	if err != nil {
+		return listOutput{}, err
+	}
+	views := make([]noteView, 0, len(notes))
+	for _, n := range notes {
+		views = append(views, toNoteView(n))
+	}
+	return listOutput{Notes: views}, nil
+}
+
+// WriteText implements cli.Output.
+func (o listOutput) WriteText(w io.Writer) error {
+	rows := make([][]string, 0, len(o.Notes))
+	for _, v := range o.Notes {
+		rows = append(rows, []string{strconv.Itoa(v.ID), v.Text})
+	}
+	return cli.WriteTable(w, []string{"ID", "TEXT"}, rows)
+}
