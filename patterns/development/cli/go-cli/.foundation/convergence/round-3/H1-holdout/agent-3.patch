+package note
+
+import (
+	"context"
+	"strings"
+	"time"
+)
+
+// Service runs the note use cases.
+type Service struct {
+	repo Repository
+	now  func() time.Time
+}
+
+// NewService returns a Service that keeps notes in repo and reads the current time from now.
+func NewService(repo Repository, now func() time.Time) *Service {
+	return &Service{repo: repo, now: now}
+}
+
+// Add creates a note with the given text.
+func (s *Service) Add(ctx context.Context, text string) (Note, error) {
+	trimmed := strings.TrimSpace(text)
+	err := validateText(trimmed)
+	if err != nil {
+		return Note{}, err
+	}
+	notes, err := s.repo.Load(ctx)
+	if err != nil {
+		return Note{}, err
+	}
+	created := Note{ID: nextID(notes), Text: trimmed, CreatedAt: s.now().UTC().Truncate(time.Second)}
+	err = s.repo.Save(ctx, append(notes, created))
+	if err != nil {
+		return Note{}, err
+	}
+	return created, nil
+}
+
+// List returns every note in ID order.
+func (s *Service) List(ctx context.Context) ([]Note, error) {
+	return s.repo.Load(ctx)
+}
+
+// nextID returns the ID for a new note, one more than the largest ID in notes.
+func nextID(notes []Note) int {
+	maxID := 0
+	for _, n := range notes {
+		maxID = max(maxID, n.ID)
+	}
+	return maxID + 1
+}
