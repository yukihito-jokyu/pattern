+// Package notestore keeps notes in a JSON file.
+package notestore
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"time"
+
+	"example.com/go-cli/internal/domain/note"
+)
+
+// Store is a note.Repository backed by one JSON file.
+type Store struct {
+	path string
+}
+
+// document is the content of the data file.
+type document struct {
+	Version int      `json:"version"`
+	Notes   []record `json:"notes"`
+}
+
+// record is how one note is stored in the data file.
+type record struct {
+	ID        int       `json:"id"`
+	Text      string    `json:"text"`
+	CreatedAt time.Time `json:"created_at"`
+}
+
+// Values of the data file.
+const (
+	formatVersion = 1
+	dirPerm       = 0o700
+)
+
+// New returns a Store that reads and writes the JSON file at path.
+func New(path string) *Store {
+	return &Store{path: path}
+}
+
+// Load implements note.Repository.
+// A missing file means no notes.
+func (s *Store) Load(ctx context.Context) ([]note.Note, error) {
+	err := ctx.Err()
+	if err != nil {
+		return nil, fmt.Errorf("load notes: %w", err)
+	}
+	data, err := os.ReadFile(s.path)
+	if errors.Is(err, fs.ErrNotExist) {
+		return make([]note.Note, 0), nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("load notes: %w", err)
+	}
+	var doc document
+	err = json.Unmarshal(data, &doc)
+	if err != nil {
+		return nil, fmt.Errorf("load notes from %s: %w", s.path, err)
+	}
+	notes := make([]note.Note, 0, len(doc.Notes))
+	for _, r := range doc.Notes {
+		notes = append(notes, toNote(r))
+	}
+	return notes, nil
+}
+
+// Save implements note.Repository.
+// It replaces the file atomically.
+func (s *Store) Save(ctx context.Context, notes []note.Note) error {
+	err := ctx.Err()
+	if err != nil {
+		return fmt.Errorf("save notes: %w", err)
+	}
+	doc := document{Version: formatVersion, Notes: make([]record, 0, len(notes))}
+	for _, n := range notes {
+		doc.Notes = append(doc.Notes, toRecord(n))
+	}
+	data, err := json.MarshalIndent(doc, "", "  ")
+	if err != nil {
+		return fmt.Errorf("save notes: %w", err)
+	}
+	err = writeFileAtomic(s.path, append(data, '\n'))
+	if err != nil {
+		return fmt.Errorf("save notes: %w", err)
+	}
+	return nil
+}
+
+// toRecord converts Note to record.
+func toRecord(n note.Note) record {
+	return record{ID: n.ID, Text: n.Text, CreatedAt: n.CreatedAt}
+}
+
+// toNote converts record to Note.
+func toNote(r record) note.Note {
+	return note.Note{ID: r.ID, Text: r.Text, CreatedAt: r.CreatedAt}
+}
+
+// writeFileAtomic writes data to a temporary file in the same directory and renames it over path, so a crash never leaves a half-written file.
+func writeFileAtomic(path string, data []byte) error {
+	dir := filepath.Dir(path)
+	err := os.MkdirAll(dir, dirPerm)
+	if err != nil {
+		return fmt.Errorf("create %s: %w", dir, err)
+	}
+	tmp, err := os.CreateTemp(dir, ".tmp-*")
+	if err != nil {
+		return fmt.Errorf("create temporary file: %w", err)
+	}
+	_, err = tmp.Write(data)
+	err = errors.Join(err, tmp.Close())
+	if err != nil {
+		return errors.Join(fmt.Errorf("write %s: %w", tmp.Name(), err), os.Remove(tmp.Name()))
+	}
+	err = os.Rename(tmp.Name(), path)
+	if err != nil {
+		return errors.Join(fmt.Errorf("rename to %s: %w", path, err), os.Remove(tmp.Name()))
+	}
+	return nil
+}
