+// Repository loads and saves all notes at once.
+type Repository interface {
+	// Load returns every saved note in ID order.
+	// It returns an empty slice when nothing is saved.
+	Load(ctx context.Context) ([]Note, error)
+	// Save replaces every saved note with notes.
+	Save(ctx context.Context, notes []Note) error
