+// Package note defines notes and the use cases that read and change them.
+package note
+
+import (
+	"fmt"
+	"strconv"
+	"time"
+	"unicode/utf8"
+
+	"example.com/go-cli/internal/errkind"
+)
+
+// Note is a piece of text to be remembered.
+type Note struct {
+	ID        int
+	Text      string
+	CreatedAt time.Time
+}
+
+// maxTextLength is the largest number of characters in a text.
+const maxTextLength = 100
+
+// ParseID converts a command-line argument to the ID field of Note.
+func ParseID(s string) (int, error) {
+	id, err := strconv.Atoi(s)
+	if err != nil || id < 1 {
+		return 0, fmt.Errorf("%w: note ID must be a positive integer: %q", errkind.ErrInvalid, s)
+	}
+	return id, nil
+}
+
+// validateText checks the Text field of Note.
+func validateText(text string) error {
+	n := utf8.RuneCountInString(text)
+	if n == 0 || n > maxTextLength {
+		return fmt.Errorf("%w: text must be 1 to %d characters", errkind.ErrInvalid, maxTextLength)
+	}
+	return nil
+}
