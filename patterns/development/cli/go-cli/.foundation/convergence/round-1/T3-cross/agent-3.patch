 import (
 	"errors"
+	"fmt"
 	"path/filepath"
+	"strconv"
+
+	"example.com/go-cli/internal/errkind"
 )
 
 // config holds the settings read from environment variables.
 type config struct {
-	dataDir string
+	dataDir  string
+	titleMax int
 }
 
 // Environment variables that configure the CLI.
 const (
 	// envDataDir overrides the directory that holds the data files.
 	envDataDir = "GOCLI_DATA_DIR"
-	envXDGData = "XDG_DATA_HOME"
-	envHome    = "HOME"
+	// envTitleMax overrides the maximum number of characters in a task title.
+	envTitleMax = "GOCLI_TITLE_MAX"
+	envXDGData  = "XDG_DATA_HOME"
+	envHome     = "HOME"
 )
+
+const defaultTitleMax = 100
 
 var errNoDataDir = errors.New("cannot find a data directory: set " + envDataDir + " or HOME")
 
-// loadConfig reads the settings. The data directory is the first of
-// $GOCLI_DATA_DIR, $XDG_DATA_HOME/go-cli and $HOME/.local/share/go-cli that is set.
+// loadConfig reads the settings.
 func loadConfig(getenv func(key string) string) (config, error) {
+	dataDir, err := loadDataDir(getenv)
+	if err != nil {
+		return config{}, err
+	}
+	titleMax, err := loadTitleMax(getenv)
+	if err != nil {
+		return config{}, err
+	}
+	return config{dataDir: dataDir, titleMax: titleMax}, nil
+}
+
+// loadDataDir returns the first of $GOCLI_DATA_DIR, $XDG_DATA_HOME/go-cli and
+// $HOME/.local/share/go-cli that is set.
+func loadDataDir(getenv func(key string) string) (string, error) {
 	dir := getenv(envDataDir)
 	if dir != "" {
-		return config{dataDir: dir}, nil
+		return dir, nil
 	}
 	dir = getenv(envXDGData)
 	if dir != "" {
-		return config{dataDir: filepath.Join(dir, name)}, nil
+		return filepath.Join(dir, name), nil
 	}
 	dir = getenv(envHome)
 	if dir != "" {
-		return config{dataDir: filepath.Join(dir, ".local", "share", name)}, nil
+		return filepath.Join(dir, ".local", "share", name), nil
 	}
-	return config{}, errNoDataDir
+	return "", errNoDataDir
 }
+
+// loadTitleMax returns $GOCLI_TITLE_MAX, or defaultTitleMax when it is empty.
+func loadTitleMax(getenv func(key string) string) (int, error) {
+	value := getenv(envTitleMax)
+	if value == "" {
+		return defaultTitleMax, nil
+	}
+	n, err := strconv.Atoi(value)
+	if err != nil || n < 1 {
+		return 0, fmt.Errorf("%w: GOCLI_TITLE_MAX must be a positive integer: %q", errkind.ErrInvalid, value)
+	}
+	return n, nil
+}
