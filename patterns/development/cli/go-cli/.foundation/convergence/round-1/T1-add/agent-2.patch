+// Remove deletes the task with the given ID and returns the task as it was before removal.
+func (s *Service) Remove(ctx context.Context, id int) (Task, error) {
+	tasks, err := s.repo.Load(ctx)
+	if err != nil {
+		return Task{}, err
+	}
+	i, err := indexOf(tasks, id)
+	if err != nil {
+		return Task{}, err
+	}
+	removed := tasks[i]
+	err = s.repo.Save(ctx, slices.Delete(tasks, i, i+1))
+	if err != nil {
+		return Task{}, err
+	}
+	return removed, nil
+}
+
