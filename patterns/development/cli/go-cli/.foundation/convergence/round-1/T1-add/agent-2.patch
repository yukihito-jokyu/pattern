+package taskcmd
+
+import (
+	"context"
+	"fmt"
+	"io"
+
+	"example.com/go-cli/internal/cli"
+	"example.com/go-cli/internal/domain/task"
+)
+
+type removeOptions struct {
+	id string
+}
+
+type removeOutput struct {
+	Task taskView `json:"task"`
+}
+
+func newRemove(svc *task.Service) *cli.Command {
+	var opts removeOptions
+	return &cli.Command{
+		Name:    "remove",
+		Summary: "Remove a task",
+		Args:    []cli.Arg{{Name: "id", Value: &opts.id}},
+		Run: func(ctx context.Context) (cli.Output, error) {
+			return runRemove(ctx, svc, opts)
+		},
+	}
+}
+
+func runRemove(ctx context.Context, svc *task.Service, opts removeOptions) (removeOutput, error) {
+	id, err := task.ParseID(opts.id)
+	if err != nil {
+		return removeOutput{}, err
+	}
+	removed, err := svc.Remove(ctx, id)
+	if err != nil {
+		return removeOutput{}, err
+	}
+	return removeOutput{Task: toTaskView(removed)}, nil
+}
+
+// WriteText implements cli.Output.
+func (o removeOutput) WriteText(w io.Writer) error {
+	_, err := fmt.Fprintf(w, "Removed task %d: %s\n", o.Task.ID, o.Task.Title)
+	return err
+}
