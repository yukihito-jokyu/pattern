+func TestParseDue(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name    string
+		s       string
+		want    time.Time
+		wantErr error
+	}{
+		{
+			name:    "accepts_a_date",
+			s:       "2026-03-04",
+			want:    time.Date(2026, time.March, 4, 0, 0, 0, 0, time.UTC),
+			wantErr: nil,
+		},
+		{name: "returns_zero_for_an_empty_string", s: "", want: time.Time{}, wantErr: nil},
+		{name: "rejects_a_date_with_a_time", s: "2026-03-04T10:00:00Z", want: time.Time{}, wantErr: errkind.ErrInvalid},
+		{name: "rejects_a_slash_date", s: "2026/03/04", want: time.Time{}, wantErr: errkind.ErrInvalid},
+		{name: "rejects_an_impossible_date", s: "2026-02-30", want: time.Time{}, wantErr: errkind.ErrInvalid},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, err := task.ParseDue(tt.s)
+			if !got.Equal(tt.want) || !errors.Is(err, tt.wantErr) {
+				t.Errorf("ParseDue(%q) = %v, %v, want %v, %v", tt.s, got, err, tt.want, tt.wantErr)
+			}
+		})
+	}
+}
