+func TestParseDue(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name    string
+		s       string
+		want    time.Time
+		wantErr error
+	}{
+		{
+			name:    "accepts_a_date",
+			s:       "2026-01-31",
+			want:    time.Date(2026, time.January, 31, 0, 0, 0, 0, time.UTC),
+			wantErr: nil,
+		},
+		{name: "returns_zero_for_an_empty_string", s: "", want: time.Time{}, wantErr: nil},
+		{name: "rejects_another_format", s: "2026/01/31", want: time.Time{}, wantErr: errkind.ErrInvalid},
+		{name: "rejects_a_date_that_does_not_exist", s: "2026-02-30", want: time.Time{}, wantErr: errkind.ErrInvalid},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, err := task.ParseDue(tt.s)
+			if !got.Equal(tt.want) || !errors.Is(err, tt.wantErr) {
+				t.Errorf("ParseDue(%q) = %v, %v, want %v, %v", tt.s, got, err, tt.want, tt.wantErr)
+			}
+		})
+	}
+}
