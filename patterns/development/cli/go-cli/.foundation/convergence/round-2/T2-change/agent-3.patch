+// ParseDue converts a command-line argument to the Due field of Task.
+// An empty string returns the zero value.
+func ParseDue(s string) (time.Time, error) {
+	if s == "" {
+		return time.Time{}, nil
+	}
+	due, err := time.Parse(time.DateOnly, s)
+	if err != nil {
+		return time.Time{}, fmt.Errorf("%w: due must be a date in YYYY-MM-DD format: %q", errkind.ErrInvalid, s)
+	}
+	return due, nil
+}
